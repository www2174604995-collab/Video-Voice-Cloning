{
  "manifest_version": 3,
  "name": "B站同声传译 · BiliSimul",
  "version": "1.0.0",
  "description": "把 B 站视频实时翻译成你设定的语言，并用视频里说话人的音色念出来。",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "B站同声传译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "js/ui.js",
        "js/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
